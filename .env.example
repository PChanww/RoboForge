# Backend-only credentials. Never expose these to the browser, logs, git or exports.
# Copy to .env and load into the backend process environment (the app reads os.environ).

# Aholo China API key: enables Lux3D single-asset generation AND World scene generation.
AHOLO_API_KEY=
# Optional aliases for Lux3D only:
LUX3D_CN_API_KEY=
LUX3D_API_KEY=

# Auxiliary / planner LLM (OpenAI-compatible). Without these the planner reports
# waiting_for_configuration; form/JSON/local-import flows still work.
AUX_MODEL_BASE_URL=
AUX_MODEL_API_KEY=
AUX_MODEL_MODEL=gpt-4o-mini

# WSL learning environment (training/eval/export jobs).
VLAB_WSL_DISTRO=Ubuntu-22.04
VLAB_LINUX_LAB=/mnt/c/Users/31295/Documents/Codex/2026-11-09/https-www-aholo3d-cn-hackathon-utm/outputs/vla-lab
VLAB_LINUX_DEPS=/mnt/c/Users/31295/Documents/Codex/2026-11-09/https-www-aholo3d-cn-hackathon-utm/work/policy/deps
VLAB_LINUX_PYTHON=/root/miniconda3/envs/voxcpm/bin/python

# Lab root override (defaults to the repository directory).
VLAB_ROOT=