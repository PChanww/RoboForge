# Keep text files LF in the repository, independent of the checkout OS.
* text=auto eol=lf

# Explicit binary formats so diffs never try to treat them as text.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.glb binary
*.obj binary
*.stl binary
*.ply binary
*.npz binary
*.pt binary
*.zip binary
*.mp4 binary
*.pdf binary
*.woff2 binary
