<?xml version="1.0" encoding="utf-8"?>
<robot name="so_arm100">
  <link name="pedestal">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/robots/so_arm100/base.obj" />
      </geometry>
      <material name="base_mat">
        <color rgba="0.89 0.91 0.94 1" />
      </material>
    </visual>
  </link>
  <link name="turret">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.08" />
      <inertia ixx="3e-05" ixy="0" ixz="0" iyy="3e-05" iyz="0" izz="3e-05" />
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.027" />
      </geometry>
    </collision>
  </link>
  <link name="upper_arm">
    <inertial>
      <origin xyz="0 0 0.11" rpy="0 0 0" />
      <mass value="0.45" />
      <inertia ixx="0.0022" ixy="0" ixz="0" iyy="0.0022" iyz="0" izz="0.0003" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/robots/so_arm100/upper.obj" />
      </geometry>
      <material name="upper_mat">
        <color rgba="0.89 0.91 0.94 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.09" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.017" length="0.14" />
      </geometry>
    </collision>
  </link>
  <link name="forearm">
    <inertial>
      <origin xyz="0 0 0.11" rpy="0 0 0" />
      <mass value="0.4" />
      <inertia ixx="0.0016" ixy="0" ixz="0" iyy="0.0016" iyz="0" izz="0.00025" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/robots/so_arm100/fore.obj" />
      </geometry>
      <material name="fore_mat">
        <color rgba="0.89 0.91 0.94 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.09" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.017" length="0.14" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.027" />
      </geometry>
    </collision>
  </link>
  <link name="wrist">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.08" />
      <inertia ixx="3e-05" ixy="0" ixz="0" iyy="3e-05" iyz="0" izz="3e-05" />
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.027" />
      </geometry>
    </collision>
  </link>
  <link name="tool">
    <inertial>
      <origin xyz="0 0 -0.02" rpy="0 0 0" />
      <mass value="0.06" />
      <inertia ixx="4e-05" ixy="0" ixz="0" iyy="4e-05" iyz="0" izz="3e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/robots/so_arm100/wrist.obj" />
      </geometry>
      <material name="wrist_mat">
        <color rgba="0.89 0.91 0.94 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.018" />
      </geometry>
    </collision>
  </link>
  <link name="eef">
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <mass value="0.09" />
      <inertia ixx="4e-05" ixy="0" ixz="0" iyy="4e-05" iyz="0" izz="4e-05" />
    </inertial>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0" />
      <geometry>
        <box size="0.032 0.08 0.016" />
      </geometry>
    </collision>
  </link>
  <link name="left">
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0" />
      <mass value="0.035" />
      <inertia ixx="2e-05" ixy="0" ixz="0" iyy="2e-05" iyz="0" izz="2e-05" />
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.028 0.012 0.044" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.036" rpy="0 0 0" />
      <geometry>
        <box size="0.024 0.01 0.032" />
      </geometry>
    </collision>
  </link>
  <link name="right">
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0" />
      <mass value="0.035" />
      <inertia ixx="2e-05" ixy="0" ixz="0" iyy="2e-05" iyz="0" izz="2e-05" />
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.028 0.012 0.044" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.036" rpy="0 0 0" />
      <geometry>
        <box size="0.024 0.01 0.032" />
      </geometry>
    </collision>
  </link>
  <joint name="waist" type="revolute">
    <parent link="pedestal" />
    <child link="turret" />
    <origin xyz="0 0 0.08" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="28" velocity="3.14" />
    <dynamics damping="0.8" />
  </joint>
  <joint name="shoulder" type="revolute">
    <parent link="turret" />
    <child link="upper_arm" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.7" upper="2.7" effort="30" velocity="3.14" />
    <dynamics damping="0.8" />
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm" />
    <child link="forearm" />
    <origin xyz="0 0 0.23" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="0.05" upper="3.08" effort="28" velocity="3.14" />
    <dynamics damping="0.8" />
  </joint>
  <joint name="wrist_pitch" type="revolute">
    <parent link="forearm" />
    <child link="wrist" />
    <origin xyz="0 0 0.23" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-3.45" upper="1.7" effort="8" velocity="3.14" />
    <dynamics damping="0.8" />
  </joint>
  <joint name="wrist_yaw" type="revolute">
    <parent link="wrist" />
    <child link="tool" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="5" velocity="3.14" />
    <dynamics damping="0.8" />
  </joint>
  <joint name="eef_fixed" type="fixed">
    <parent link="tool" />
    <child link="eef" />
    <origin xyz="0 0 -0.075" rpy="0 0 0" />
  </joint>
  <joint name="left" type="prismatic">
    <parent link="eef" />
    <child link="left" />
    <origin xyz="0 0.006 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0.065" effort="9" velocity="3.14" />
    <dynamics damping="4" />
  </joint>
  <joint name="right" type="prismatic">
    <parent link="eef" />
    <child link="right" />
    <origin xyz="0 -0.006 0" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="0.065" effort="9" velocity="3.14" />
    <dynamics damping="4" />
  </joint>
</robot>
